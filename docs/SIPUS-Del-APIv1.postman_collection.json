        {
          "name": "POST Check Clearance (Mahasiswa Ada Pinjaman Aktif)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:sip=\"http://sipus.del.ac.id/soap\">\n    <soap:Body>\n        <sip:CheckClearanceStatusRequest>\n            <sip:nim_peminjam>12S24001</sip:nim_peminjam>\n        </sip:CheckClearanceStatusRequest>\n    </soap:Body>\n</soap:Envelope>"
            },
            "url": {
              "raw": "{{base_url}}/soap/sipus",
              "host": ["{{base_url}}"],
              "path": ["soap", "sipus"]
            }
          }
        },
